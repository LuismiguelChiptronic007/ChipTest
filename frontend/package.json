{
  "name": "chiptest-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "wrangler dev",
    "db:local:migrate": "wrangler d1 migrations apply chiptest-db --local --config wrangler.jsonc",
    "db:remote:migrate": "wrangler d1 migrations apply chiptest-db --remote --config wrangler.jsonc",
    "db:local:status": "wrangler d1 migrations list chiptest-db --local --config wrangler.jsonc",
    "db:remote:status": "wrangler d1 migrations list chiptest-db --remote --config wrangler.jsonc",
    "seed": "node scripts/seed-codigos.mjs",
    "seed:clear": "node scripts/seed-codigos.mjs --clear",
    "typecheck": "nuxt typecheck",
    "test": "vitest run --config frontend/vitest.config.ts --root .. backend/src/services/importacoes.test.ts backend/src/services/testes.test.ts frontend/server/utils/importacao-docx.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "domhandler": "^6.0.1",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "nuxt": "^3.17.5",
    "pinia": "^3.0.2",
    "sanitize-html": "^2.18.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@pinia/nuxt": "^0.10.1",
    "@types/node": "^22.15.30",
    "@types/sanitize-html": "^2.16.2",
    "nitro-cloudflare-dev": "^0.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.10",
    "wrangler": "^4.50.0"
  }
}
